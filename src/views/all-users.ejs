<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ol>
        <% users.forEach(user => { %>
        <li>
           <p> <strong>Name:</strong> <%= user.name %></p> 
           <p><strong>Email (username):</strong> <%= user.email %></p>
            <p><strong>Role:</strong> <%= user.role_name %></p>
        </li>
        <% }) %>
    </ol>
</main>

<%- include('partials/footer') %>