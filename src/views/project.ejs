<%- include('partials/header') %>

<main>
    <h1><%= title %></h1> 
    <p>Name: <%= service_project.title %></p>
    <p>Description: <%= service_project.description %></p>
    <p>Date: <%= service_project.project_date %></p>
    <p>Location: <%= service_project.location %></p>
    <p>Organization: 
        <a href="/organization/<%= service_project.organization_id %>">
            <%= service_project.organization_name %>
        </a>
    </p>

    <ul>
        <% projectCategories.forEach(category => { %>
            <li>
                project Category: <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
            </li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/project/<%= service_project.project_id %>/assign-categories" class="other_pages_link">Edit Categories</a>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-project/<%= service_project.project_id %>" class="other_pages_link">Edit Project</a>
    <% } %>



    
<% if (user && user.role_name !== 'admin') { %>
    <% if (isLoggedIn && !isVolunteer) { %>

        <a href="/project/<%= service_project.project_id %>/volunteer"
        class="other_pages_link">
            Volunteer for this project
        </a>

    <% } else if (isLoggedIn && isVolunteer) { %>

            <a href="/project/<%= service_project.project_id %>/volunteer" class="other_pages_link">You are volunteering for this project.</a>

        <form action="/project/<%= service_project.project_id %>/remove-volunteer-project" method="POST">
        <button>Remove me as a volunteer</button>
        </form>
    <% } %>  
<% } %>  
</main>

<%- include('partials/footer') %>